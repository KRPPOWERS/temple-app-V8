<?xml version="1.0" encoding="utf-8"?>
<!-- Splash screen background — dark gold, shown while WebView loads -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#0D0A06" />
        </shape>
    </item>
    <!-- Gold Om symbol placeholder (replace with actual temple logo bitmap) -->
    <item android:gravity="center">
        <shape android:shape="oval">
            <solid android:color="#C9922A" />
            <size android:width="96dp" android:height="96dp" />
        </shape>
    </item>
</layer-list>
